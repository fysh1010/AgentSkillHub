{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSkillHub",
  "version": "0.2.1",
  "identifier": "com.agentskillhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentSkillHub · AI Agent 技能管理台",
        "width": 1320,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
